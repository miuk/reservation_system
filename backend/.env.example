PORT=8080
FIREBASE_PROJECT_ID=your-firebase-project-id
FIRESTORE_PROJECT_ID=your-firestore-project-id
FIRESTORE_DATABASE_ID=(default)
FRONTEND_ORIGIN=http://localhost:5173
